---
import '../styles.css';
import { withBase } from '../base.js';
const { title = 'Will Gao', description = 'Will Gao studies computer science and mathematics at the University of Washington. Research, mathematical notes, and selected work.', active = '', article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="author" content="Will Gao"/><title>{title === 'Will Gao' ? title : `${title} | Will Gao`}</title><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Will Gao"/><link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Instrument+Sans:wght@400;500;600&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Will Gao',alternateName:'William Gao',url:Astro.site, sameAs:['https://www.linkedin.com/in/willhgao/','https://substack.com/@willhgao','https://x.com/willhgao']})}/></head>
<body><a class="skip" href="#main">Skip to content</a><div class:list={['shell', { 'reading-shell':article }]}><header class="site-header"><a class="wordmark" href={withBase('/')} aria-label="Will Gao — home">Will Gao<span class="name-period">.</span></a><nav aria-label="Main navigation">{[['Writing','/writing/'],['Notes','/notes/'],['Research','/research/'],['Teaching','/teaching/'],['About','/about/']].map(([name,url]) => <a href={withBase(url)} aria-current={active===name ? 'page' : undefined}>{name}</a>)}</nav></header><main id="main" class:list={[{'page-enter':!article}]}><slot/></main><footer class="site-footer"><div><a href="mailto:wgaostudio@gmail.com">Email</a><a href="https://substack.com/@willhgao">Substack</a><a href="https://x.com/willhgao">X</a><a href="https://www.linkedin.com/in/willhgao/">LinkedIn</a></div></footer></div></body></html>
