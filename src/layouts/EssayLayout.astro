---
import Layout from './Layout.astro';
import { withBase } from '../base.js';
const {title, subtitle, description, source, sourceUrl, date, dateISO, author = 'Will Gao'} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const articleSchema = {'@context':'https://schema.org','@type':'Article',headline:title,description,url:canonical.toString(),author:{'@type':'Person',name:author},...(dateISO ? {datePublished:dateISO} : {})};
---
<Layout title={title} description={description} active="Writing" article structuredData={articleSchema}>
  <article class="essay">
    <header class="essay-header"><a class="text-link" href={withBase('/writing/')}>← Writing</a><h1>{title}</h1>{subtitle && <p class="essay-subtitle">{subtitle}</p>}<p class="meta">{author}{date && <> · <time datetime={dateISO}>{date}</time></>}<br/>Originally published {source === 'Substack' ? 'on' : 'in'} <a href={sourceUrl}>{source}</a>.</p></header>
    <div class="essay-content"><slot/></div>
    <p class="essay-end"><a href={sourceUrl}>Read the original on {source}</a> · <a href={withBase('/writing/')}>All writing</a></p>
  </article>
</Layout>
