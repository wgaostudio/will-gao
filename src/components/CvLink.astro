---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { withBase } from '../base.js';
const available=existsSync(join(process.cwd(),'public/cv.pdf'));
---
{available ? <a href={withBase('/cv.pdf')}>CV (PDF)</a> : <span class="resource-pending">CV (PDF) <span>— coming soon</span></span>}
